{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:openssf-scorecard",
    "helpers:pinGitHubActionDigestsToSemver",
    ":configMigration",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separatePatchReleases"
  ],
  "enabledManagers": [
    "github-actions",
    "pep621",
    "cargo",
    "npm",
    "gomod"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": [
    "before 8am every weekday"
  ],
  "minimumReleaseAge": "7 days",
  "dependencyDashboardTitle": "Dependency Dashboard",
  "dependencyDashboardLabels": [
    "dependencies",
    "dependency-lifecycle"
  ],
  "labels": [
    "dependencies",
    "dependency-lifecycle"
  ],
  "rangeStrategy": "auto",
  "pinDigests": true,
  "rebaseWhen": "conflicted",
  "prCreation": "immediate",
  "internalChecksFilter": "strict",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 6,
  "ignorePaths": [
    "requirements/python/**",
    "**/node_modules/**",
    "**/target/**",
    "**/build/**",
    "**/dist/**",
    "artifacts/**"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ],
    "automerge": false,
    "addLabels": [
      "manual-review"
    ]
  },
  "packageRules": [
    {
      "description": "Route GitHub Actions updates to the CI area; only selected patch releases can auto-queue.",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": false,
      "addLabels": [
        "area/ci"
      ]
    },
    {
      "description": "Require manual review for other GitHub Actions, including their patch releases.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "!actions/upload-artifact",
        "!actions/download-artifact"
      ],
      "automerge": false,
      "addLabels": [
        "manual-review"
      ]
    },
    {
      "description": "Keep non-patch changes to the official artifact actions under manual review.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/upload-artifact",
        "actions/download-artifact"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "digest",
        "pin",
        "bump",
        "replacement",
        "rollback"
      ],
      "automerge": false,
      "addLabels": [
        "manual-review"
      ]
    },
    {
      "description": "Queue trusted GitHub artifact Action patch releases only after the seven-day release-age status and all required checks pass.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/upload-artifact",
        "actions/download-artifact"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": false,
      "addLabels": [
        "automerge"
      ]
    },
    {
      "description": "Route Python package metadata updates.",
      "matchManagers": [
        "pep621"
      ],
      "addLabels": [
        "area/python"
      ]
    },
    {
      "description": "Route Rust dependency updates.",
      "matchManagers": [
        "cargo"
      ],
      "addLabels": [
        "area/rust"
      ]
    },
    {
      "description": "Route Node.js dependency updates.",
      "matchManagers": [
        "npm"
      ],
      "addLabels": [
        "area/node"
      ]
    },
    {
      "description": "Route Go dependency updates.",
      "matchManagers": [
        "gomod"
      ],
      "addLabels": [
        "area/go"
      ]
    },
    {
      "description": "Require Dependency Dashboard approval for breaking upgrades.",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "addLabels": [
        "breaking-change",
        "manual-review"
      ]
    },
    {
      "description": "Keep compiler and Python build-backend changes under manual review.",
      "matchPackageNames": [
        "typescript",
        "setuptools"
      ],
      "automerge": false,
      "addLabels": [
        "manual-review"
      ]
    },
    {
      "description": "Opt low-risk Node development updates into Mergify after all required checks pass.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": false,
      "addLabels": [
        "automerge"
      ],
      "matchPackageNames": [
        "!typescript"
      ]
    },
    {
      "description": "Label stable, non-major runtime dependency updates for Mergify after required CI checks.",
      "matchManagers": [
        "npm",
        "cargo",
        "gomod",
        "pep621"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "matchPackageNames": [
        "!typescript",
        "!setuptools"
      ],
      "automerge": false,
      "addLabels": [
        "automerge"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "prCreation": "immediate",
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null,
    "labels": [
      "dependencies",
      "area/security",
      "manual-review"
    ]
  },
  "osvVulnerabilityAlerts": true
}
