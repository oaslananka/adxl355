{
  "name": "@oaslananka/adxl355",
  "version": "0.1.0-alpha.3",
  "description": "Typed, transport-agnostic ADXL355 accelerometer driver for Node.js",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "keywords": [
    "adxl355",
    "accelerometer",
    "sensor",
    "spi",
    "i2c",
    "embedded",
    "raspberry-pi"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm run build && npm pack --dry-run --json > .npm-pack.json && node scripts/check-package.mjs",
    "audit:ci": "npm audit --audit-level=moderate",
    "native:check": "node scripts/check-native-modules.mjs",
    "pack:core-only": "npm run build && npm pack --json > .npm-install-pack.json && node scripts/check-core-only-install.mjs .npm-install-pack.json"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaslananka/adxl355.git",
    "directory": "node"
  },
  "homepage": "https://github.com/oaslananka/adxl355#readme",
  "bugs": {
    "url": "https://github.com/oaslananka/adxl355/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./linux/spi": {
      "types": "./dist/linux/spi.d.ts",
      "import": "./dist/linux/spi.js"
    },
    "./linux/i2c": {
      "types": "./dist/linux/i2c.d.ts",
      "import": "./dist/linux/i2c.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "i2c-bus": "5.2.3",
    "spi-device": "3.1.2"
  }
}
